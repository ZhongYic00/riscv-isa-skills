+class DecodeTreeNode:
+    """Represents a node in the decode tree extracted from the ISA grammar."""
+    def __init__(self, kind, **kwargs):
+        self.kind = kind
+        self.__dict__.update(kwargs)
+
+    def to_dict(self):
+        d = {"kind": self.kind}
+        for k, v in sorted(self.__dict__.items()):
+            if k == "kind":
+                continue
+            if isinstance(v, DecodeTreeNode):
+                d[k] = v.to_dict()
+            elif isinstance(v, list):
+                d[k] = [
+                    item.to_dict() if isinstance(item, DecodeTreeNode) else item
+                    for item in v
+                ]
+            else:
+                d[k] = v
+        return d
+
+
+def _collect_subsets(node):
+    """Recursively collect all subset/format values from instruction descendants."""
+    subsets = set()
+    if node.kind == 'instruction':
+        if hasattr(node, 'subset') and node.subset:
+            subsets.add(node.subset)
+        elif hasattr(node, 'format') and node.format and node.format != 'Unknown':
+            subsets.add(node.format)
+    if hasattr(node, 'children'):
+        for child in node.children:
+            if child.kind == 'case':
+                subsets.update(_collect_subsets(child.target))
+    if hasattr(node, 'target'):
+        subsets.update(_collect_subsets(node.target))
+    return subsets
+
+
+def _collect_subset_tree(node):
+    """Collect subset info grouped by direct children case nodes.
+    Returns list of (case_value, subset_set) tuples."""
+    result = []
+    if node.kind == 'block' and hasattr(node, 'children'):
+        for child in node.children:
+            if child.kind == 'case':
+                subsets = _collect_subsets(child.target)
+                result.append((child.case_values, subsets))
+    return result
+
